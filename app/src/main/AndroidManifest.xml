<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Avisar de un mensaje riesgoso (#10). Solo Android 13 o superior lo pide en tiempo de ejecución. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Enviar los aportes anónimos al backend (#72, solo con el aporte activado, solo por HTTPS). Clasificar, alertar y mostrar los mensajes
        no usan la red. Motivo y alcance en docs/permisos-sms.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        El envío de aportes pendientes (#71) usa WorkManager, que agrega ACCESS_NETWORK_STATE (saber si hay conexión), RECEIVE_BOOT_COMPLETED
        (retomar el envío tras reiniciar) y WAKE_LOCK. Los permisos de servicio en primer plano que también agrega no se usan: se quitan.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmishingDetector"
        tools:targetApi="31">

        <!-- singleTop: tocar una alerta con la app abierta abre el detalle en la misma pantalla, no en otra copia. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SmishingDetector.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Los cuatro componentes siguientes son lo que Android exige a una app para ofrecerla como aplicación de SMS
            predeterminada (RF-01, #2). El de SMS guarda los mensajes desde #4; los demás siguen vacíos (MMS no tiene historia; redactar y enviar, #6).
            No piden permisos de SMS: esos se piden después del rol, y solo los necesarios (#3).
        -->

        <!-- Enlaces sms:, smsto:, mms: y mmsto: para redactar un mensaje. -->
        <activity
            android:name=".ui.ComposeSmsActivity"
            android:exported="true"
            android:theme="@style/Theme.SmishingDetector">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- SMS entrantes: solo el sistema puede enviarlos (BROADCAST_SMS). -->
        <receiver
            android:name=".data.sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Resultado de enviar un SMS (#6): solo la app lo recibe, a través de su PendingIntent. -->
        <receiver
            android:name=".data.sms.SmsSentReceiver"
            android:exported="false" />

        <!-- MMS entrantes: solo el sistema puede enviarlos (BROADCAST_WAP_PUSH). -->
        <receiver
            android:name=".data.sms.MmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- "Responder por mensaje" al rechazar una llamada. -->
        <service
            android:name=".data.sms.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

    </application>

</manifest>
